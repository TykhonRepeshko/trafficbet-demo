# Local development only. Generate .env with scripts/setup.ps1.
# No shared/default passwords. Do not commit .env or print its contents in logs.
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:4200
COOKIE_SECURE=false
POSTGRES_PASSWORD=
POSTGRES_RUNTIME_PASSWORD=
WORKER_TOKEN=
SOURCE_OBSERVER_ENABLED=true
VIDEO_EVIDENCE_ENABLED=false
AUTOMATIC_SETTLEMENT_ENABLED=false
HYBRID_MOTION_ENABLED=false
# Optional NVIDIA acceleration (requires the CUDA Compose override).
COUNTER_DEVICE=cpu
COUNTER_MODEL=yolox-tiny
# Experimental full-resolution road ROI; enable only after camera validation.
COUNTER_MOTION_RESOLUTION=legacy
SEED_DEMO_DATA=false
DEMO_ADMIN_PASSWORD=
DEMO_PLAYER_PASSWORD=
MEDIA_ALLOWED_HOSTS=kamera.vegvesen.no,wzmedia.dot.ca.gov,cwwp2.dot.ca.gov
# DATABASE_URL is composed inside Docker. Native Go requires it in process env.

# Sample cadence for the six reviewed clear road sources.
COUNTER_SAMPLE_FPS=5
